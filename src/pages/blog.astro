---
import { getCollection } from 'astro:content'
import * as dateFns from 'date-fns'
import kebabCase from 'lodash/kebabCase'
import Layout from '../layouts/Layout.astro'
import PostPreview from '../components/Post/Preview.astro'
import LinkPreview from '../components/Post/LinkPreview.astro'
import { getLinkPostDate } from '../content/links'

const blogPosts = (await getCollection('blog')).map((entry) => ({
  type: 'blog' as const,
  entry,
  date: entry.data.date,
  tags: entry.data.tags,
}))

const linkPosts = (await getCollection('links')).map((entry) => ({
  type: 'links' as const,
  entry,
  date: getLinkPostDate(entry.data),
  tags: entry.data.properties.Tags,
}))

const allPosts = [...blogPosts, ...linkPosts].sort((a, b) =>
  dateFns.compareDesc(a.date, b.date)
)

const tags = [
  ...allPosts
    .reduce((acc, curr) => {
      curr.tags?.forEach((tag: string) => acc.set(kebabCase(tag), tag))
      return acc
    }, new Map<string, string>())
    .entries(),
]
  .map(([slug, name]) => ({ slug, name }))
  .sort((a, b) => (a.name < b.name ? -1 : 1))

/**
 * Filtering is done entirely in CSS off the checked radio, so a tag stays
 * applied without JavaScript having to re-run on every interaction. The tag
 * list is dynamic, hence the generated stylesheet.
 */
const tagsCss = tags
  .map(
    ({ slug }) => `
#post-list:has(#tag-filter-${slug}:checked) > #posts > *:not(.tag-${slug}) {
  display: none;
}
`
  )
  .join('\n')
---

<style set:html={tagsCss}></style>

<Layout
  title="Blog"
  description="Thoughts, tutorials, musings, album reviews and everything in between that I have written down."
>
  <div id="post-list" class="paper prose">
    <h1 class="mb-0">Blog</h1>
    <p class="mb-2">
      Thoughts, tutorials, musings, album reviews and everything in between that
      I have written down. I try to write four posts a year, but I'm not super
      strict about that.
    </p>
    <h6 id="tag-filter-label">Filter by tag</h6>
    <div
      id="tag-filter"
      class:list={['filter', 'not-prose', 'font-sans']}
      role="group"
      aria-labelledby="tag-filter-label"
    >
      <input
        id="tag-filter-all"
        class:list={[
          'btn',
          'btn-primary',
          'btn-xs',
          'sm:btn-md',
          'filter-reset',
        ]}
        type="radio"
        name="tag"
        value=""
        aria-label="All"
        checked
      />
      {
        tags.map((tag) => (
          <input
            id={`tag-filter-${tag.slug}`}
            class:list={['btn', 'btn-primary', 'btn-xs', 'sm:btn-md']}
            type="radio"
            name="tag"
            value={tag.slug}
            aria-label={tag.name}
          />
        ))
      }
    </div>
    <div id="posts" class:list={['flex', 'flex-col', 'gap-y-4', 'mt-4']}>
      {
        allPosts.map((item) =>
          item.type === 'blog' ? (
            <PostPreview entry={item.entry} />
          ) : (
            <LinkPreview entry={item.entry} />
          )
        )
      }
    </div>
  </div>
</Layout>

<style>
  /* daisyUI squares the reset control off for a bare "×"; this one is a word. */
  #tag-filter .filter-reset:not(:checked) {
    aspect-ratio: auto;
  }
</style>

<script>
  // The filter itself is CSS. This only keeps the `#<tag>` URLs working, which
  // is how tag links have always been shared.
  const filter = document.getElementById('tag-filter')
  const radios = Array.from(
    filter?.querySelectorAll<HTMLInputElement>('input[type="radio"]') ?? []
  )
  const reset = radios.find((radio) => !radio.value)

  const currentTag = () => decodeURIComponent(window.location.hash.slice(1))

  const applyHash = () => {
    const tag = currentTag()
    const match = radios.find((radio) => radio.value && radio.value === tag)

    if (match) {
      match.checked = true
    } else if (reset) {
      reset.checked = true
    }
  }

  radios.forEach((radio) => {
    radio.addEventListener('change', () => {
      if (!radio.checked || radio.value === currentTag()) {
        return
      }

      const { pathname, search } = window.location
      // `pushState` rather than assigning `location.hash`: it keeps the back
      // button stepping through filters the way the old anchors did, without
      // the browser trying to scroll to an element named after the tag.
      window.history.pushState(
        null,
        '',
        radio.value ? `#${radio.value}` : `${pathname}${search}`
      )
    })
  })

  window.addEventListener('hashchange', applyHash)
  applyHash()
</script>
