---
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Resume/Footer.astro'
import ResumeIsland from '../components/Resume/Resume'
import { getResumeSource } from '../lib/resume/build'
import { pageCss } from '../lib/resumeTailor/layout'

const source = await getResumeSource()
---

<Layout
  title="Resume"
  description="You should hire me! My resume is pretty nice and I can bring a lot to any team."
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/json"
      href="/resume.json"
      title="JSON Resume"
    />
    <Fragment set:html={`<style>${pageCss}</style>`} />
  </Fragment>
  <ResumeIsland client:load source={source} />
  <Footer />
</Layout>
