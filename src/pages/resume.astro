---
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Resume/Footer.astro'
import ResumeIsland from '../components/Resume/Resume'
import { getResumeSource } from '../lib/resume/build'
import { pageCss } from '../lib/resumeTailor/layout'

const source = await getResumeSource()
---

<Layout
  title="Resume"
  description="You should hire me! My resume is pretty nice and I can bring a lot to any team."
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/json"
      href="/resume.json"
      title="JSON Resume"
    />
    <Fragment set:html={`<style>${pageCss}</style>`} />
    <!-- Chrome WebMCP origin trial for eligundry.com, expires 2026-11-17 -->
    <meta
      http-equiv="origin-trial"
      content="A/UWzGZ1JWR/mB8FJKaptuDr8Z7J48cDSzuMIGxXWlf6kxaGdNDg6mXfzkilkGeFMkBSahmEiTB93KdE+JY7uAEAAABheyJvcmlnaW4iOiJodHRwczovL2VsaWd1bmRyeS5jb206NDQzIiwiZmVhdHVyZSI6IldlYk1DUCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNUaGlyZFBhcnR5Ijp0cnVlfQ=="
    />
  </Fragment>
  <ResumeIsland client:load source={source} />
  <Footer />
</Layout>
