---
import EmojiText from '../EmojiText.astro'
import { getEntry } from 'astro:content'

const basics = (await getEntry('resumeBasics', 'eli'))!.data
const github = basics.profiles.find((p) => p.network === 'GitHub')
const site = new URL(basics.url)
---

<footer
  class:list={[
    ['hidden', 'print:flex'],
    'flex-row',
    'fixed',
    'w-full',
    'font-sans',
    ['font-bold', '[&_.emoji]:font-normal'],
    'text-xs',
    'bottom-0',
    'gap-6',
    '[&_a]:link-primary',
    ['border-t-2', 'border-t-accent'],
    'pt-2',
    '[&_.emoji]:mt-1',
  ]}
  data-print-footer
>
  <span>
    <EmojiText
      emoji="💌"
      label="envelop with heart because you will love emailing me"
    >
      <a href={`mailto:${basics.email}`}>{basics.email}</a>
    </EmojiText>
  </span>
  <span>
    <EmojiText emoji="📞" label="call me maybe">
      <a href={`tel:${basics.phone.replace(/\D/g, '')}`}>{basics.phone}</a>
    </EmojiText>
  </span>
  <address class="not-italic">
    <EmojiText emoji="📍" label="drop a pin cause I am in Astoria">
      {basics.location.city}, {basics.location.region}
    </EmojiText>
  </address>
  <span>
    <EmojiText emoji="💾" label="floppy disk that my website is saved on">
      <a href={basics.url}> {site.host}</a>
    </EmojiText>
  </span>
  <span>
    <EmojiText emoji="👨‍💻" label="lil man at computer because i'm coding">
      <a href={github?.url}>github/{github?.username}</a>
    </EmojiText>
  </span>
</footer>
