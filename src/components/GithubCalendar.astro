---
// This code is adapted from  https://github.com/grubersjoe/react-activity-calendar
// I wanted to be able to do the data fetching server side and just serve the
// calendar as static HTML. Each day is a grid cell so it can use daisyUI's
// tooltip, which SVG elements can't.
import * as dateFns from 'date-fns'
import retry from 'async-retry'
import config from '../config'

interface Props {
  className?: string
}

interface GithubApiResponse {
  total: {
    [year: number | string]: number
  }
  contributions: {
    date: string
    count: number
    level: number
  }[]
}

// This renders at build time, so a failed request leaves the calendar out of
// the page rather than failing the whole build.
const contributions = await retry(
  async () => {
    const url = new URL(
      `https://github-contributions-api.jogruber.de/v4/${config.github}`
    )
    url.searchParams.set('y', 'last')

    const resp = await fetch(url)

    // fetch doesn't reject on HTTP errors, so throw to trigger a retry
    if (!resp.ok) {
      throw new Error(`${resp.status} ${resp.statusText}`)
    }

    const data: GithubApiResponse = await resp.json()

    return data.contributions.map((c) => ({
      ...c,
      date: dateFns.parseISO(c.date),
    }))
  },
  {
    retries: 3,
    minTimeout: 500,
  }
).catch((e) => {
  console.warn('could not fetch GitHub contributions', e)
  return []
})

const firstDay = contributions[0]?.date
const weeks = firstDay
  ? dateFns.differenceInCalendarWeeks(contributions.at(-1)!.date, firstDay) + 1
  : 0

// Tooltips are centered over their day by default, which runs off the edge of
// the page for the first and last few weeks, so those open inwards instead.
const edgeWeeks = 6
const tooltipPlacement = (week: number) => {
  if (week < edgeWeeks) {
    return 'tooltip-right'
  }

  if (week >= weeks - edgeWeeks) {
    return 'tooltip-left'
  }

  return null
}

const levelClasses: Record<number, string> = {
  0: 'bg-neutral',
  1: 'bg-primary/[.44]',
  2: 'bg-primary/[.60]',
  3: 'bg-primary/[.76]',
  4: 'bg-primary',
}

const total = contributions.reduce((sum, c) => sum + c.count, 0)

// Geometry of the SVG this replaced, in px at full size: 12px days with a 4px
// gap, a 1px stroke centered on each day's edge, and 1px of padding on either
// side. Below full width it scaled down to fit, so every length here is a
// multiple of --u, which is 1px at full width and shrinks with the container.
const blockSize = 12
const blockMargin = 4
const height = (blockSize + blockMargin) * 7 - blockMargin
const width = weeks * (blockSize + blockMargin) - blockMargin + 2
---

{
  contributions.length > 0 && (
    <div
      class:list={[
        'not-prose',
        'flex',
        'items-center',
        'w-full',
        '@container',
        Astro.props.className,
      ]}
      style={{ maxWidth: `${width}px`, height: `${height}px` }}
    >
      <div
        role="img"
        aria-label={`${total} GitHub contributions in the last year`}
        class="grid grid-flow-col"
        style={{
          '--u': `calc(100cqw / ${width})`,
          paddingInline: 'var(--u)',
          gap: `calc(${blockMargin} * var(--u))`,
          gridTemplateColumns: `repeat(${weeks}, calc(${blockSize} * var(--u)))`,
          gridTemplateRows: `repeat(7, calc(${blockSize} * var(--u)))`,
        }}
      >
        {contributions.map((day) => {
          const week = dateFns.differenceInCalendarWeeks(day.date, firstDay)

          return (
            <div
              data-tip={`${day.count} contribution${day.count === 1 ? '' : 's'} on ${dateFns.format(day.date, 'MMMM d, yyyy')}`}
              class:list={[
                'tooltip',
                'tooltip-primary',
                tooltipPlacement(week),
                'block',
                'font-sans',
                'rounded-[calc(2*var(--u))]',
                // The stroke straddles the day's edge like an SVG stroke. It's a
                // pair of shadows rather than an outline or border because those
                // round up to 1px, which reads as a heavy grid on small screens.
                '[box-shadow:0_0_0_calc(var(--u)/2)_var(--color-base-300),inset_0_0_0_calc(var(--u)/2)_var(--color-base-300)]',
                levelClasses[day.level] ?? levelClasses[0],
              ]}
              style={{
                gridColumn: week + 1,
                gridRow: dateFns.getDay(day.date) + 1,
              }}
            />
          )
        })}
      </div>
    </div>
  )
}
