---
// This code is adapted from  https://github.com/grubersjoe/react-activity-calendar
// I wanted to be able to do the data fetching server side and just serve the
// calendar as static HTML. Each day is a grid cell so it can use daisyUI's
// tooltip, which SVG elements can't.
import * as dateFns from 'date-fns'
import retry from 'async-retry'
import config from '../config'
import axios from 'axios'

interface Props {
  className?: string
}

interface GithubApiResponse {
  total: {
    [year: number | string]: number
  }
  contributions: {
    date: string
    count: number
    level: number
  }[]
}

const contributions = await retry(
  async () => {
    const resp = await axios.get<GithubApiResponse>(
      `https://github-contributions-api.jogruber.de/v4/${config.github}`,
      {
        params: {
          y: 'last',
        },
      }
    )

    return resp.data.contributions.map((c) => ({
      ...c,
      date: dateFns.parseISO(c.date),
    }))
  },
  {
    retries: 3,
    minTimeout: 500,
  }
)

const firstDay = contributions[0].date
const weeks =
  dateFns.differenceInCalendarWeeks(contributions.at(-1)!.date, firstDay) + 1

// Tooltips are centered over their day by default, which runs off the edge of
// the page for the first and last few weeks, so those open inwards instead.
const edgeWeeks = 6
const tooltipPlacement = (week: number) => {
  if (week < edgeWeeks) {
    return 'tooltip-right'
  }

  if (week >= weeks - edgeWeeks) {
    return 'tooltip-left'
  }

  return null
}

const levelClasses: Record<number, string> = {
  0: 'bg-neutral',
  1: 'bg-primary/[.44]',
  2: 'bg-primary/[.60]',
  3: 'bg-primary/[.76]',
  4: 'bg-primary',
}

const total = contributions.reduce((sum, c) => sum + c.count, 0)
---

<div
  role="img"
  aria-label={`${total} GitHub contributions in the last year`}
  class:list={[
    'not-prose',
    'grid',
    'grid-flow-col',
    'grid-rows-7',
    'gap-0.5',
    'sm:gap-1',
    'w-full',
    'max-w-[846px]',
    Astro.props.className,
  ]}
  style={{ gridTemplateColumns: `repeat(${weeks}, minmax(0, 1fr))` }}
>
  {
    contributions.map((day) => {
      const week = dateFns.differenceInCalendarWeeks(day.date, firstDay)

      return (
        <div
          data-tip={`${day.count} contribution${day.count === 1 ? '' : 's'} on ${dateFns.format(day.date, 'MMMM d, yyyy')}`}
          class:list={[
            'tooltip',
            'tooltip-primary',
            tooltipPlacement(week),
            'block',
            'aspect-square',
            'rounded-[2px]',
            'border',
            'border-base-300',
            'font-sans',
            levelClasses[day.level] ?? levelClasses[0],
          ]}
          style={{
            gridColumn: week + 1,
            gridRow: dateFns.getDay(day.date) + 1,
          }}
        />
      )
    })
  }
</div>
