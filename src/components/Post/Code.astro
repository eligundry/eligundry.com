---
// Code blocks scroll sideways when lines run long, so they take tabindex="0"
// (like Shiki's own <pre>) to be scrollable from the keyboard.
---

{
  Astro.props.class && (
    <pre
      class:list={['astro-code', 'astro-code-compact', Astro.props.class]}
      tabindex="0"
    >
      <slot />
    </pre>
  )
}
{
  !Astro.props.class && (
    <pre tabindex="0">
      <slot />
    </pre>
  )
}
